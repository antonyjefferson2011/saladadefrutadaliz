rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // TROQUE pelo e-mail do administrador criado em Authentication.
    function admin() { return request.auth != null && request.auth.token.email == 'COLOQUE_O_EMAIL_DO_ADMIN@exemplo.com'; }
    match /products/{id} { allow read: if true; allow write: if admin(); }
    match /gallery/{id}  { allow read: if true; allow write: if admin(); }
    match /settings/{id} { allow read, write: if admin(); }
    match /orders/{id} {
      allow read, update, delete: if admin();
      allow create: if request.resource.data.keys().hasOnly(['name','items','total','notes','status','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 30
        && request.resource.data.total is number && request.resource.data.total > 0
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 500
        && request.resource.data.status == 'novo';
    }
  }
}
